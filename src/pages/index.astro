---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="sv">
	<head>
		<BaseHead title={SITE_TITLE} description="Välkommen till Teklas - serier, konst, bokrecensioner och krönikor på en personlig sajt. Inga flöden eller algoritmer, bara innehåll som är värt din tid." />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: SITE_TITLE,
			url: 'https://teklas.se',
			description: 'Välkommen till Teklas - serier, konst, bokrecensioner och krönikor på en personlig sajt. Inga flöden eller algoritmer, bara innehåll som är värt din tid.',
		})} />
	</head>
	<body>
		<Header />
		<main class="w-full max-w-6xl mx-auto px-6 py-12">
			<section class="text-center mb-12">
				<h1 class="text-4xl sm:text-6xl font-bold text-dark mb-3 tracking-tight">{SITE_TITLE}</h1>
				<p class="text-lg sm:text-xl text-gray-600">{SITE_DESCRIPTION}</p>
			</section>

			<section class="w-full max-w-3xl mx-auto mb-12" aria-label="Sök och filtrera inlägg">
				<div class="relative">
					<svg
						class="absolute left-5 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-400 pointer-events-none"
						xmlns="http://www.w3.org/2000/svg"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="2"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
					</svg>
					<label for="search-input" class="sr-only">Sök bland inlägg</label>
					<input
						id="search-input"
						type="search"
						placeholder="Sök bland serier, konst, bokrecensioner och krönikor..."
						autocomplete="off"
						class="w-full text-lg sm:text-xl pl-14 pr-24 py-5 rounded-2xl border-2 border-gray-200 bg-white text-dark shadow-md placeholder:text-gray-400 focus:border-accent focus:outline-none transition-colors"
					/>
					<kbd
						id="search-shortcut"
						class="pointer-events-none absolute right-5 top-1/2 hidden -translate-y-1/2 select-none items-center rounded-lg border border-gray-200 bg-gray-50 px-2 py-1 text-xs font-semibold text-gray-400 sm:flex"
						aria-hidden="true"
					>
						Ctrl K
					</kbd>
				</div>

				<div class="mt-4 grid sm:grid-cols-2 gap-4">
					<div>
						<label for="category-select" class="block text-sm font-semibold text-gray-500 mb-1"
							>Kategori</label
						>
						<select
							id="category-select"
							class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 bg-white font-semibold text-gray-700 focus:border-accent focus:outline-none transition-colors cursor-pointer"
						>
							<option value="all">Alla kategorier</option>
							{
								Object.entries(CATEGORIES).map(([key, cat]) => (
									<option value={key}>{cat.label}</option>
								))
							}
						</select>
					</div>
					<div>
						<label for="sort-select" class="block text-sm font-semibold text-gray-500 mb-1"
							>Sortera efter</label
						>
						<select
							id="sort-select"
							class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 bg-white font-semibold text-gray-700 focus:border-accent focus:outline-none transition-colors cursor-pointer"
						>
							<option value="date-desc">Nyast först</option>
							<option value="date-asc">Äldst först</option>
							<option value="title-asc">Titel A till Ö</option>
							<option value="title-desc">Titel Ö till A</option>
						</select>
					</div>
				</div>

				<p id="results-count" class="mt-3 text-sm text-gray-500" aria-live="polite"></p>
			</section>

			<div class="grid md:grid-cols-2 gap-8 items-start" id="post-grid">
				{
					allPosts.map((post) => (
						<a
							href={`/blog/${post.id}/`}
							class="post-card group bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 block"
							data-id={post.id}
							data-category={post.data.category}
							data-label={CATEGORIES[post.data.category].label}
							data-title={post.data.title}
							data-description={post.data.description}
							data-date={post.data.pubDate.toISOString()}
						>
							{post.data.heroImage && (
								<div class="aspect-[2/1] overflow-hidden">
									<Image
										width={720}
										height={360}
										src={post.data.heroImage}
										alt={`Omslagsbild till ${post.data.title}`}
										loading="lazy"
										decoding="async"
										class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
									/>
								</div>
							)}
							<div class="p-6">
								<div class="flex items-center gap-3 mb-3">
									<span
										class="px-3 py-1 rounded-full text-xs font-bold text-cream"
										style={`background-color: ${CATEGORIES[post.data.category].color}`}
									>
										{CATEGORIES[post.data.category].label}
									</span>
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h3 class="post-card-title text-xl font-bold text-dark group-hover:text-accent transition-colors">
									{post.data.title}
								</h3>
								<p class="post-card-description mt-2 text-gray-600 text-sm line-clamp-2">
									{post.data.description}
								</p>
							</div>
						</a>
					))
				}
			</div>

			<p id="empty-state" class="text-center py-16 text-gray-500 text-lg hidden">
				Inga inlägg matchar din sökning.
			</p>
		</main>
		<Footer />

		<script>
			type SearchIndexItem = { id: string; body?: string; tags?: string[] };
			type CardContent = {
				title: string;
				description: string;
				titleEl: Element | null;
				descEl: Element | null;
			};

			const searchInput = document.getElementById('search-input') as HTMLInputElement;
			const categorySelect = document.getElementById('category-select') as HTMLSelectElement;
			const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
			const grid = document.getElementById('post-grid') as HTMLElement;
			const emptyState = document.getElementById('empty-state') as HTMLElement;
			const resultsCount = document.getElementById('results-count') as HTMLElement;
			const shortcutHint = document.getElementById('search-shortcut');

			const cards = Array.from(grid.querySelectorAll<HTMLElement>('.post-card'));
			const searchIndex = new Map<string, string>();
			const cardContent = new Map<HTMLElement, CardContent>();

			let fullIndexRequested = false;
			let debounceTimer: number | undefined;

			cards.forEach((card) => {
				const titleEl = card.querySelector('.post-card-title');
				const descEl = card.querySelector('.post-card-description');
				cardContent.set(card, {
					title: titleEl ? titleEl.textContent || '' : '',
					description: descEl ? descEl.textContent || '' : '',
					titleEl,
					descEl,
				});
			});

			if (shortcutHint) {
				const isMac = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent);
				shortcutHint.textContent = isMac ? '⌘ K' : 'Ctrl K';
			}

			function normalize(value: string | undefined): string {
				return (value || '').toLowerCase();
			}

			function escapeHtml(value: string): string {
				return value.replace(/[&<>"']/g, (char: string) => {
					switch (char) {
						case '&':
							return '&amp;';
						case '<':
							return '&lt;';
						case '>':
							return '&gt;';
						case '"':
							return '&quot;';
						default:
							return '&#39;';
					}
				});
			}

			function escapeRegExp(value: string): string {
				return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
			}

			function highlight(value: string, terms: string[]): string {
				const safe = escapeHtml(value);
				if (terms.length === 0) return safe;
				const pattern = new RegExp(`(${terms.map(escapeRegExp).join('|')})`, 'gi');
				return safe.replace(pattern, '<mark class="rounded-sm bg-warm/70 px-0.5 text-dark">$1</mark>');
			}

			function cardText(card: HTMLElement): string {
				return normalize(
					[
						card.dataset.title,
						card.dataset.description,
						card.dataset.label,
						searchIndex.get(card.dataset.id ?? ''),
					].join(' '),
				);
			}

			// The full-text index is only fetched when someone actually searches,
			// so visitors never download post bodies just to browse the homepage.
			function loadFullIndex(): Promise<void> {
				if (fullIndexRequested) return Promise.resolve();
				fullIndexRequested = true;
				return fetch('/search-index.json')
					.then((response) => (response.ok ? response.json() : []))
					.then((index: SearchIndexItem[]) => {
						index.forEach((item) => {
							const tags = Array.isArray(item.tags) ? item.tags.join(' ') : '';
							searchIndex.set(item.id, [item.body, tags].filter(Boolean).join(' '));
						});
					})
					.catch(() => {});
			}

			function sortCards(list: HTMLElement[]): HTMLElement[] {
				const mode = sortSelect.value;
				return [...list].sort((a, b) => {
					if (mode === 'title-asc' || mode === 'title-desc') {
						const cmp = (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '', 'sv');
						return mode === 'title-asc' ? cmp : -cmp;
					}
					const aTime = new Date(a.dataset.date ?? '').valueOf();
					const bTime = new Date(b.dataset.date ?? '').valueOf();
					return mode === 'date-asc' ? aTime - bTime : bTime - aTime;
				});
			}

			function hasOption(select: HTMLSelectElement, value: string): boolean {
				return Array.from(select.options).some((option) => option.value === value);
			}

			function updateUrl(push: boolean): void {
				const params = new URLSearchParams();
				const query = searchInput.value.trim();
				if (query) params.set('q', query);
				if (categorySelect.value !== 'all') params.set('category', categorySelect.value);
				if (sortSelect.value !== 'date-desc') params.set('sort', sortSelect.value);

				const search = params.toString();
				const url = search ? `?${search}` : window.location.pathname;
				if (push) history.pushState(null, '', url);
				else history.replaceState(null, '', url);
			}

			function applyFilters(options: { push?: boolean } = {}): void {
				const settings = options;
				const rawQuery = searchInput.value.trim();
				const terms = normalize(rawQuery).split(/\s+/).filter(Boolean);
				const category = categorySelect.value;

				const matching = cards.filter((card) => {
					if (category !== 'all' && card.dataset.category !== category) return false;
					if (terms.length === 0) return true;
					const text = cardText(card);
					return terms.every((term) => text.includes(term));
				});

				sortCards(matching).forEach((card) => grid.appendChild(card));
				const matchingSet = new Set(matching);
				cards.forEach((card) => {
					card.style.display = matchingSet.has(card) ? '' : 'none';
				});

				cards.forEach((card) => {
					const content = cardContent.get(card);
					if (!content) return;
					const activeTerms = matchingSet.has(card) ? terms : [];
					if (content.titleEl) content.titleEl.innerHTML = highlight(content.title, activeTerms);
					if (content.descEl) content.descEl.innerHTML = highlight(content.description, activeTerms);
				});

				emptyState.classList.toggle('hidden', matching.length > 0);
				resultsCount.textContent = `${matching.length} av ${cards.length} inlägg`;

				updateUrl(settings.push === true);

				if (terms.length > 0 && !fullIndexRequested) {
					resultsCount.textContent += ' · söker i fulltext…';
					loadFullIndex().then(() => applyFilters());
				}
			}

			function readStateFromUrl(): void {
				const params = new URLSearchParams(window.location.search);
				const query = params.get('q');
				const category = params.get('category');
				const sort = params.get('sort');

				searchInput.value = query ?? '';
				categorySelect.value = category && hasOption(categorySelect, category) ? category : 'all';
				sortSelect.value = sort && hasOption(sortSelect, sort) ? sort : 'date-desc';
			}

			searchInput.addEventListener('input', () => {
				window.clearTimeout(debounceTimer);
				debounceTimer = window.setTimeout(() => applyFilters(), 150);
			});

			categorySelect.addEventListener('change', () => applyFilters({ push: true }));
			sortSelect.addEventListener('change', () => applyFilters({ push: true }));

			window.addEventListener('popstate', () => {
				readStateFromUrl();
				applyFilters();
			});

			document.addEventListener('keydown', (event) => {
				if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
					event.preventDefault();
					searchInput.focus();
					searchInput.select();
				}
			});

			readStateFromUrl();
			applyFilters();
		</script>
	</body>
</html>
