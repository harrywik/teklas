---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="sv">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: SITE_TITLE,
			url: 'https://teklas.se',
			description: SITE_DESCRIPTION,
		})} />
	</head>
	<body>
		<Header />
		<main class="max-w-6xl mx-auto px-6 py-12">
			<section class="text-center mb-12">
				<h1 class="text-6xl font-bold text-dark mb-3 tracking-tight">{SITE_TITLE}</h1>
				<p class="text-xl text-gray-600">{SITE_DESCRIPTION}</p>
			</section>

			<div class="flex flex-wrap gap-3 justify-center mb-12" id="filters">
				<button
					data-category="all"
					class="filter-btn px-6 py-2 rounded-full font-semibold text-sm transition-all shadow-sm bg-dark text-cream shadow-md"
				>
					Alla
				</button>
				{
					Object.entries(CATEGORIES).map(([key, cat]) => (
						<button
							data-category={key}
							class="filter-btn px-6 py-2 rounded-full font-semibold text-sm transition-all shadow-sm bg-white text-gray-700 hover:shadow-md"
						>
							{cat.label}
						</button>
					))
				}
			</div>

			<div class="grid md:grid-cols-2 gap-8" id="post-grid">
				{
					allPosts.map((post) => (
						<a
							href={`/blog/${post.id}/`}
							class="post-card group bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 block"
							data-category={post.data.category}
						>
							{post.data.heroImage && (
								<div class="aspect-[2/1] overflow-hidden">
									<Image
										width={720}
										height={360}
										src={post.data.heroImage}
										alt=""
										class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
									/>
								</div>
							)}
							<div class="p-6">
								<div class="flex items-center gap-3 mb-3">
									<span
										class="px-3 py-1 rounded-full text-xs font-bold text-cream"
										style={`background-color: ${CATEGORIES[post.data.category].color}`}
									>
										{CATEGORIES[post.data.category].label}
									</span>
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h3 class="text-xl font-bold text-dark group-hover:text-accent transition-colors">
									{post.data.title}
								</h3>
							</div>
						</a>
					))
				}
			</div>

			<p id="empty-state" class="text-center py-16 text-gray-500 text-lg hidden">
				Inga inlägg i denna kategori ännu.
			</p>
		</main>
		<Footer />

		<script>
			const buttons = document.querySelectorAll('.filter-btn');
			const cards = document.querySelectorAll('.post-card');
			const emptyState = document.getElementById('empty-state');

			buttons.forEach((btn) => {
				btn.addEventListener('click', () => {
					const cat = btn.dataset.category;

					buttons.forEach((b) => {
						b.className =
							'filter-btn px-6 py-2 rounded-full font-semibold text-sm transition-all shadow-sm bg-white text-gray-700 hover:shadow-md';
					});
					btn.className =
						'filter-btn px-6 py-2 rounded-full font-semibold text-sm transition-all shadow-sm bg-dark text-cream shadow-md';

					let visible = 0;
					cards.forEach((card) => {
						if (cat === 'all' || card.dataset.category === cat) {
							card.style.display = '';
							visible++;
						} else {
							card.style.display = 'none';
						}
					});

					emptyState.classList.toggle('hidden', visible > 0);
				});
			});
		</script>
	</body>
</html>
