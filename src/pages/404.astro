---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="sv">
	<head>
		<BaseHead title={`404 — ${SITE_TITLE}`} description="Sidan hittades inte" />
	</head>
	<body>
		<Header />
		<main class="max-w-4xl mx-auto px-6 py-12 text-center">
			<div class="mb-8">
				<h1 class="text-9xl font-bold text-accent mb-4">404</h1>
				<h2 class="text-3xl font-bold text-dark mb-6">Hittar inte sidan</h2>
				<p class="text-xl text-gray-600 mb-8">
					Sidan du letar efter finns inte eller har flyttats.
				</p>
			</div>

			<div class="flex justify-center items-center">
				<a
					href="/"
					class="px-16 py-6 bg-accent text-cream rounded-full font-semibold hover:bg-accent-dark transition-colors shadow-lg text-lg"
				>
					Till startsidan
				</a>
			</div>

			<div class="mt-16 pt-8 border-t border-gray-200">
				<p class="text-gray-500">
					Kanske kan något av dessa hjälpa dig vidare?
				</p>
				<div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-4 text-left">
					<a href="/?category=cartoon" class="block p-4 bg-white rounded-lg shadow hover:shadow-md transition-shadow">
						<span class="text-2xl mb-2 block">🎨</span>
						<span class="font-semibold text-dark">Serier</span>
						<p class="text-sm text-gray-600 mt-1">Originala seriestrippar</p>
					</a>
					<a href="/?category=art" class="block p-4 bg-white rounded-lg shadow hover:shadow-md transition-shadow">
						<span class="text-2xl mb-2 block">🖼️</span>
						<span class="font-semibold text-dark">Konst</span>
						<p class="text-sm text-gray-600 mt-1">Illustrationer och skisser</p>
					</a>
					<a href="/?category=book-review" class="block p-4 bg-white rounded-lg shadow hover:shadow-md transition-shadow">
						<span class="text-2xl mb-2 block">📚</span>
						<span class="font-semibold text-dark">Bokrecensioner</span>
						<p class="text-sm text-gray-600 mt-1">Tankar om böcker</p>
					</a>
					<a href="/?category=opinion-piece" class="block p-4 bg-white rounded-lg shadow hover:shadow-md transition-shadow">
						<span class="text-2xl mb-2 block">✍️</span>
						<span class="font-semibold text-dark">Krönikor</span>
						<p class="text-sm text-gray-600 mt-1">Perspektiv och reflektioner</p>
					</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
