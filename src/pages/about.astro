---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="sv">
	<head>
		<BaseHead title={`Om | ${SITE_TITLE}`} description="Teklas är en personlig plats på nätet för serier, konst, bokrecensioner och krönikor. Här delar jag saker jag ritat, skrivit och läst - helt utan algoritmer." />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'AboutPage',
			name: `Om ${SITE_TITLE}`,
			url: 'https://teklas.se/about/',
			description: 'Teklas är en personlig plats på nätet för serier, konst, bokrecensioner och krönikor. Här delar jag saker jag ritat, skrivit och läst - helt utan algoritmer.',
		})} />
	</head>
	<body class="min-h-screen">
		<Header />
		<main class="max-w-3xl mx-auto px-6 py-12">
			<h1 class="text-4xl sm:text-5xl font-bold text-dark mb-8">Om Teklas</h1>
			<div class="prose text-gray-700 space-y-6">
				<p class="text-lg leading-relaxed sm:text-xl">
					Välkommen till <strong class="text-dark">Teklas</strong>: en personlig hörna av internet för
					serier, konst och bokrecensioner.
				</p>
				<p class="text-lg leading-relaxed sm:text-xl">
					Här delar jag saker jag ritat, serier jag gjort och böcker jag läst. Inga
					algoritmer, inga flöden. Bara grejer jag tycker är värda att dela med världen.
				</p>
			</div>

			<div class="mt-12 pt-8 border-t border-gray-200">
				<h2 class="text-2xl font-bold text-dark mb-6 text-center">Kontaktuppgifter</h2>
				<div class="grid sm:grid-cols-2 gap-8">
					<div class="text-center">
						<p class="text-lg font-semibold text-dark">Tekla Svensson</p>
						<p class="text-sm text-gray-500 mb-2">Sidägare och ansvarig utgivare</p>
						<div class="flex items-center justify-center gap-2">
							<p class="email-display text-gray-700" data-obfuscated="xalentinax [at] gmail.com">
								xalentinax [at] gmail.com
							</p>
							<button
								type="button"
								data-email="xalentinax@gmail.com"
								data-copy-label="Kopiera e-postadress"
								data-copied-label="Kopierad!"
								class="email-copy inline-flex items-center justify-center w-8 h-8 rounded-lg transition-colors"
								aria-label="Kopiera e-postadress"
								title="Kopiera e-postadress"
							>
								<svg
									class="email-copy-icon w-4 h-4"
									xmlns="http://www.w3.org/2000/svg"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
									<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
								</svg>
								<svg
									class="email-check-icon w-4 h-4 hidden"
									xmlns="http://www.w3.org/2000/svg"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M20 6 9 17l-5-5" />
								</svg>
							</button>
						</div>
					</div>
					<div class="text-center">
						<p class="text-lg font-semibold text-dark">Harry Wik</p>
						<p class="text-sm text-gray-500 mb-2">Tekniska frågor eller problem</p>
						<div class="flex items-center justify-center gap-2">
							<p class="email-display text-gray-700" data-obfuscated="mail [at] harrywik.com">
								mail [at] harrywik.com
							</p>
							<button
								type="button"
								data-email="mail@harrywik.com"
								data-copy-label="Kopiera e-postadress"
								data-copied-label="Kopierad!"
								class="email-copy inline-flex items-center justify-center w-8 h-8 rounded-lg transition-colors"
								aria-label="Kopiera e-postadress"
								title="Kopiera e-postadress"
							>
								<svg
									class="email-copy-icon w-4 h-4"
									xmlns="http://www.w3.org/2000/svg"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
									<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
								</svg>
								<svg
									class="email-check-icon w-4 h-4 hidden"
									xmlns="http://www.w3.org/2000/svg"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M20 6 9 17l-5-5" />
								</svg>
							</button>
						</div>
						<div class="flex gap-4 mt-4 justify-center">
							<a href="https://www.linkedin.com/in/harrywik/" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-dark transition-colors" aria-label="LinkedIn">
								<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
							</a>
							<a href="https://github.com/harrywik/" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-dark transition-colors" aria-label="GitHub">
								<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
							</a>
							<a href="https://harrywik.com" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-dark transition-colors" aria-label="Webbsida">
								<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
							</a>
						</div>
					</div>
				</div>
			</div>
		</main>
		<Footer />

		<script>
			const copyButtons = document.querySelectorAll('.email-copy');

			async function copyToClipboard(text: string) {
				if (navigator.clipboard?.writeText) {
					try {
						await navigator.clipboard.writeText(text);
						return;
					} catch {
						// Fall through to the legacy method below.
					}
				}

				const textarea = document.createElement('textarea');
				textarea.value = text;
				textarea.setAttribute('readonly', '');
				textarea.style.position = 'absolute';
				textarea.style.left = '-9999px';
				document.body.appendChild(textarea);
				textarea.select();
				document.execCommand('copy');
				document.body.removeChild(textarea);
			}

			copyButtons.forEach((btn) => {
				btn.addEventListener('click', async () => {
					const button = btn as HTMLButtonElement;
					const display = button.parentElement?.querySelector('.email-display') as HTMLElement | null;
					if (!display) return;

					const email = button.dataset.email ?? '';
					const obfuscated = display.dataset.obfuscated ?? display.textContent ?? '';
					const copyIcon = button.querySelector('.email-copy-icon');
					const checkIcon = button.querySelector('.email-check-icon');

					try {
						await copyToClipboard(email);
					} catch {
						// Still reveal the address so it can be copied manually.
					}

					display.textContent = email;
					button.dataset.copied = 'true';
					button.setAttribute('aria-label', button.dataset.copiedLabel ?? 'Kopierad!');
					copyIcon?.classList.add('hidden');
					checkIcon?.classList.remove('hidden');

					window.setTimeout(() => {
						display.textContent = obfuscated;
						delete button.dataset.copied;
						button.setAttribute('aria-label', button.dataset.copyLabel ?? 'Kopiera e-postadress');
						copyIcon?.classList.remove('hidden');
						checkIcon?.classList.add('hidden');
					}, 2500);
				});
			});
		</script>
	</body>
</html>
