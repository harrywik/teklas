---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORIES, SITE_AUTHOR, SITE_TITLE } from '../consts';
import { tagToSlug } from '../lib/tags';

type Props = CollectionEntry<'blog'>['data'] & {
	category: string;
	prevPost: CollectionEntry<'blog'> | null;
	nextPost: CollectionEntry<'blog'> | null;
	relatedPosts: CollectionEntry<'blog'>[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	tags,
	prevPost,
	nextPost,
	relatedPosts,
} = Astro.props;
const cat = CATEGORIES[category as keyof typeof CATEGORIES];

const postUrl = new URL(Astro.url.pathname, Astro.site);
const heroImageUrl = heroImage ? await getImage({ src: heroImage }).then((img) => new URL(img.src, Astro.site).href) : undefined;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: {
		'@type': 'Person',
		name: SITE_AUTHOR,
	},
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		url: Astro.site,
	},
	url: postUrl.href,
	articleSection: cat?.label,
	...(tags.length > 0 && { keywords: tags.join(', ') }),
	...(heroImageUrl && { image: heroImageUrl }),
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': postUrl.href,
	},
};
---

<html lang="sv">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			imageAlt={`Omslagsbild till ${title}`}
			type="article"
			publishedTime={pubDate}
			modifiedTime={updatedDate ?? pubDate}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>

	<body class="min-h-screen">
		<Header />
		<main class="w-full max-w-4xl mx-auto px-6 py-12">
			<article>
				{heroImage && (
					<div class="mb-8 rounded-2xl overflow-hidden shadow-xl">
						<Image
							width={1020}
							height={510}
							src={heroImage}
							alt={`Omslagsbild till ${title}`}
							loading="eager"
							fetchpriority="high"
							decoding="async"
							class="w-full"
						/>
					</div>
				)}
				<div class="text-center mb-8">
					<div class="flex items-center justify-center gap-3 mb-4">
						{cat && (
							<a
								href={`/?category=${category}`}
								class="px-4 py-1 rounded-full text-sm font-bold text-cream"
								style={`background: ${cat.color}`}
							>
								{cat.label}
							</a>
						)}
						<FormattedDate date={pubDate} />
					</div>
					<h1 class="text-3xl sm:text-5xl font-bold text-dark mb-4">{title}</h1>
					<p class="text-lg sm:text-xl text-gray-500 mb-6">{description}</p>
					{tags.length > 0 && (
						<ul class="mb-6 flex flex-wrap justify-center gap-2">
							{tags.map((tag) => (
								<li>
									<a
										href={`/tag/${tagToSlug(tag)}/`}
										class="inline-block rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600 transition-colors hover:bg-accent hover:text-cream"
									>
										#{tag}
									</a>
								</li>
							))}
						</ul>
					)}
					<hr class="border-gray-300 max-w-xs mx-auto" />
				</div>
				<div class="prose max-w-none text-gray-700">
					<slot />
				</div>
			</article>

			<nav class="mt-16 pt-8 border-t border-gray-300">
				<div class="flex flex-col sm:flex-row justify-between gap-4">
					{prevPost ? (
						<a
							href={`/blog/${prevPost.id}/`}
							class="group bg-white rounded-xl p-6 shadow-md hover:shadow-lg transition-all"
						>
							<span class="text-sm text-gray-500 block mb-1">← Föregående</span>
							<span class="text-lg font-semibold text-dark group-hover:text-accent transition-colors">
								{prevPost.data.title}
							</span>
						</a>
					) : (
						<div></div>
					)}
					{nextPost ? (
						<a
							href={`/blog/${nextPost.id}/`}
							class="group bg-white rounded-xl p-6 shadow-md hover:shadow-lg transition-all sm:text-right"
						>
							<span class="text-sm text-gray-500 block mb-1">Nästa →</span>
							<span class="text-lg font-semibold text-dark group-hover:text-accent transition-colors">
								{nextPost.data.title}
							</span>
						</a>
					) : (
						<div></div>
					)}
				</div>
			</nav>

			{relatedPosts.length > 0 && (
				<section class="mt-16 pt-8 border-t border-gray-300" aria-labelledby="related-heading">
					<h2 id="related-heading" class="mb-6 text-2xl font-bold text-dark">Relaterade inlägg</h2>
					<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{relatedPosts.map((post) => (
							<a
								href={`/blog/${post.id}/`}
								class="group overflow-hidden rounded-xl bg-white shadow-md transition-all hover:-translate-y-1 hover:shadow-lg"
							>
								{post.data.heroImage && (
									<div class="aspect-[2/1] overflow-hidden">
										<Image
											width={480}
											height={240}
											src={post.data.heroImage}
											alt={`Omslagsbild till ${post.data.title}`}
											loading="lazy"
											decoding="async"
											class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
										/>
									</div>
								)}
								<div class="p-5">
									<h3 class="text-lg font-bold text-dark transition-colors group-hover:text-accent">
										{post.data.title}
									</h3>
									<p class="mt-1 line-clamp-2 text-sm text-gray-600">{post.data.description}</p>
								</div>
							</a>
						))}
					</div>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>
