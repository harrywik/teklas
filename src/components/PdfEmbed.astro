---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: string;
	title: string;
	description?: string;
	cover?: ImageMetadata;
	coverAlt?: string;
}

const { src, title, description, cover, coverAlt = '' } = Astro.props;
---

<figure class="not-prose my-10">
	<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-xl">
		<div class="flex items-center justify-between gap-4 border-b border-gray-200 px-5 py-3">
			<span class="flex items-center gap-2 text-sm font-semibold text-dark">
				<svg
					class="w-5 h-5 shrink-0 text-accent"
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					stroke-width="2"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5A3.375 3.375 0 0 0 10.125 2.25H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
					/>
				</svg>
				{title}
			</span>
			<span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-gray-500">
				PDF
			</span>
		</div>

		<div class="pdf-preview bg-gray-50" data-pdf-src={src} data-pdf-title={title}>
			{
				cover ? (
					<button
						type="button"
						class="pdf-load group relative block w-full cursor-pointer"
						aria-label={`Visa ${title}`}
					>
						<Image src={cover} alt={coverAlt} loading="lazy" decoding="async" class="mx-auto h-auto w-full max-w-xl" />
						<span class="absolute inset-0 flex items-center justify-center bg-dark/5 transition-colors group-hover:bg-dark/25">
							<span class="flex items-center gap-2 rounded-full bg-white/95 px-5 py-2.5 text-sm font-semibold text-dark shadow-lg transition-transform group-hover:scale-105">
								<svg
									class="w-4 h-4"
									xmlns="http://www.w3.org/2000/svg"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2"
									aria-hidden="true"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"
									/>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
									/>
								</svg>
								Visa dokumentet
							</span>
						</span>
					</button>
				) : (
					<button
						type="button"
						class="pdf-load w-full cursor-pointer px-6 py-12 text-center font-semibold text-dark hover:bg-gray-100"
					>
						Visa dokumentet
					</button>
				)
			}
		</div>

		<div class="flex flex-col gap-3 border-t border-gray-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
			{description && <p class="text-sm text-gray-600 sm:max-w-xl">{description}</p>}
			<div class="flex shrink-0 flex-wrap gap-2">
				<a
					href={src}
					target="_blank"
					rel="noopener noreferrer"
					class="rounded-full bg-dark px-4 py-2 text-sm font-semibold text-cream transition-colors hover:bg-accent"
				>
					Öppna i nytt fönster
				</a>
				<a
					href={src}
					download
					class="rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 transition-colors hover:border-accent hover:text-accent"
				>
					Ladda ner
				</a>
			</div>
		</div>
	</div>
</figure>

<script>
	const previews = document.querySelectorAll('.pdf-preview');

	previews.forEach((preview) => {
		const trigger = preview.querySelector('.pdf-load');
		trigger?.addEventListener('click', () => {
			const src = preview.getAttribute('data-pdf-src');
			const title = preview.getAttribute('data-pdf-title') ?? '';
			if (!src) return;

			const frame = document.createElement('iframe');
			frame.src = src;
			frame.title = title;
			frame.className = 'h-[75vh] min-h-[520px] w-full';
			frame.setAttribute('loading', 'lazy');
			preview.replaceChildren(frame);
		});
	});
</script>
