---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="bg-dark text-cream sticky top-0 z-50 shadow-lg">
	<nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
		<a href="/" class="text-2xl font-bold tracking-wide hover:text-accent transition-colors">
			{SITE_TITLE}
		</a>
		<div class="flex gap-4">
			<HeaderLink href="/">Hem</HeaderLink>
			<HeaderLink href="/about">Om</HeaderLink>
			<a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-full font-semibold text-sm transition-all text-cream/70 hover:text-cream hover:bg-white/10">CV</a>
		</div>
	</nav>
</header>
