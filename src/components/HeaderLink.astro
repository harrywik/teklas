---
const { href } = Astro.props;
const isActive = Astro.url.pathname === href;
---

<a
	href={href}
	class={`px-4 py-2 rounded-full font-semibold text-sm transition-all ${
		isActive
			? 'bg-accent text-cream shadow-md'
			: 'text-cream/70 hover:text-cream hover:bg-white/10'
	}`}
>
	<slot />
</a>
